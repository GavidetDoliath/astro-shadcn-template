---
export const prerender = false;

import NewspaperEditor from '@/components/admin/newspaper/NewspaperEditor';
import { getNewspaperEditionById } from '@/lib/newspaper';
import { getArticles } from '@/lib/articles';

// Auth check (middleware handles this, but verify)
const user = Astro.locals.user;
if (!user || user.role !== 'admin') {
  return Astro.redirect('/admin/login');
}

// Get edition ID from query param
const editionId = Astro.url.searchParams.get('id');
if (!editionId) {
  return Astro.redirect('/admin/newspapers');
}

// Load edition
const edition = await getNewspaperEditionById(editionId);
if (!edition) {
  return Astro.redirect('/admin/newspapers');
}

// Load articles for picker
const allArticles = await getArticles(100);
const articles = allArticles.map(a => ({
  id: a.id,
  title: a.title,
  excerpt: a.excerpt,
}));
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{edition.title} · Éditeur</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=UnifrakturMaguntia&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var isDark = stored === 'dark' || (stored !== 'light' && prefersDark);
        if (isDark) document.documentElement.classList.add('dark');
      })();
    </script>
  </head>
  <body>
    <NewspaperEditor client:load initialEdition={edition} articles={articles} />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    font-family: var(--font-mono, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif);
  }

  body {
    background: #f5f5f5;
  }
</style>
